APP_ENV=analysis-staging
APP_PRODUCT=analysis
MONGO_URL=mongodb+srv://USER:PASSWORD@ANALYSIS_CLUSTER/pmublonab_analysis?retryWrites=true&w=majority
DB_NAME=pmublonab_analysis
JWT_SECRET=replace-with-analysis-only-random-secret
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-an-analysis-only-password
ADMIN_PASSCODE=replace-with-temporary-analysis-passcode
BETA_ACCESS_CODES=
GEMINI_API_KEY=replace-with-your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=180
GEMINI_MAX_RETRIES=2
GEMINI_RETRY_BACKOFF_SECONDS=4
CORS_ORIGINS=https://pmublonab-analysis-web.onrender.com,https://pmublonab-analysis-admin.onrender.com
